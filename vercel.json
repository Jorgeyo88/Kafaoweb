{
  "buildCommand": "rm -rf .vercel/output/functions .vercel/output/nitro.json && echo static-ok",
  "installCommand": "echo skip-install",
  "outputDirectory": ".vercel/output/static",
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
